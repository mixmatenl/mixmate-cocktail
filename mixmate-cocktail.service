[Unit]
Description=MIXMATE Cocktailmachine — Loadcell Sender
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/mixmate-cocktail
ExecStart=/usr/bin/python3 /home/pi/mixmate-cocktail/loadcell_sender.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
